[package]
name        = "pkix-chain"
description = "High-level X.509 certificate chain verification (pkix-path + pkix-revocation)"
version.workspace     = true
edition.workspace     = true
rust-version.workspace = true
license.workspace     = true
repository.workspace  = true
authors.workspace     = true
keywords    = ["x509", "certificate", "pki", "pkix", "chain"]
categories  = ["cryptography"]

[features]
default     = ["pkix-path/default"]
rustcrypto  = ["pkix-path/rustcrypto"]
crl         = ["pkix-revocation/crl"]
ocsp        = ["pkix-revocation/ocsp"]

[dependencies]
pkix-path       = { workspace = true, features = ["std"] }
pkix-revocation = { workspace = true, features = ["std"] }
x509-cert       = { workspace = true }

[dev-dependencies]

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]
