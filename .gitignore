
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Cargo build output
/target/

# Stray build artifacts in repo root
*.rlib
test_must_use*
/rust_out*

# Review-loop transient artifacts (phase markers, coordinator logs).
# Permitted permanent planning lives in <crate>/PLAN.md only.
/audit/

# pkix-difftest pyca/cryptography venv (bootstrapped by setup-venv.sh).
